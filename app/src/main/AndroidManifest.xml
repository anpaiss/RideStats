<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google sign-in and Drive upload, over WiFi or through the Karoo's link to the phone -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to send again, when the network comes back, a ride that ended out of WiFi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The finished rides in /sdcard/FitFiles -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Backup of our other extensions to Drive: their providers ask for this, same signature only.
         Declared here too, so it works whichever app is installed first. -->
    <permission
        android:name="com.anpaiss.permission.EXTENSION_BACKUP"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.anpaiss.permission.EXTENSION_BACKUP" />
    <!-- targetSdk 28: no package visibility rules, the backup providers of our extensions are found by permission -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RideStatsExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

    </application>
</manifest>
