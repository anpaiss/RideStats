<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/intro"
            android:layout_marginTop="12dp"
            android:text="@string/intro"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/code_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#222222"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/code_hint"
                android:textColor="#BDBDBD"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/code_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/code_hint2"
                android:textColor="#BDBDBD"
                android:textSize="16sp"
                android:gravity="center" />

            <!-- Google's codes grew to 12 characters ("VQM-BQQ-YRFW", 442 px at 30sp
                 in the Karoo font, 375 px of room): at a fixed 30sp the end was cut
                 and Google said "wrong code" (issue #1). Shrinks until it fits. -->
            <TextView
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#FF5823"
                android:textStyle="bold"
                android:maxLines="1"
                android:gravity="center"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="30sp"
                android:autoSizeStepGranularity="1sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/send"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/backup_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/backup_header"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/backup_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_intro"
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/backup_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/restore_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#222222"
            android:visibility="gone">

            <TextView
                android:id="@+id/restore_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_restore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_keep"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/backup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
